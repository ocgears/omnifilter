{
  "name": "omnifilter",
  "version": "0.0.2",
  "description": "\"Awesome filters applied to personal images\"",
  "main": "server/server.js",
  "directories": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocgears/omnifilter.git"
  },
  "author": "Stephen Salzer, Aaron Filson, Gene Troy, Erika Hokanson, Rob Merrill",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ocgears/omnifilter/issues"
  },
  "homepage": "https://github.com/ocgears/omnifilter#readme",
  "dependencies": {
    "angular": "~1.8.3",
    "angular-route": "~1.8.3",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "node-addon-api": "^8.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "angular-mocks": "~1.8.3",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "eslint": "^8.57.1",
    "gulp": "^5.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-sass": "^6.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "html-loader": "^5.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "^5.1.0",
    "mocha": "^10.8.2",
    "sass": "~1.93.0",
    "webpack": "^5.97.0",
    "webpack-stream": "^7.0.0"
  },
  "scripts": {
    "install": "node scripts/install-native.js",
    "build": "gulp",
    "build:prod": "gulp build:prod",
    "heroku-postbuild": "OMNIFILTER_API=/ gulp build:prod",
    "mongo": "mkdir -p db && mongod --dbpath=./db",
    "test": "mkdir -p db && (mongod --dbpath=./db > db/mongod.log 2>&1 &) && mocha --exit --timeout 10000 --file server/test/setup.js server/test",
    "test:client": "gulp webpack:test && karma start",
    "lint": "eslint .",
    "lint:client": "eslint app gulpfile.js karma.conf.js",
    "start": "mkdir -p db && (mongod --dbpath=./db > db/mongod.log 2>&1 &) && node clientserver & node server/server",
    "fetch-models": "node scripts/fetch-models.js",
    "devices": "node scripts/devices.js",
    "check-device": "node scripts/check-device.js"
  },
  "keywords": [
    "image-filter",
    "parallel-programming",
    "super-fast-filter",
    "omni",
    "filter",
    "filters"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "gypfile": true,
  "optionalDependencies": {
    "onnxruntime-node": "1.19.2"
  }
}
