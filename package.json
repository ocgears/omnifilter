{
  "name": "omnifilter",
  "version": "0.0.2",
  "description": "\"Awesome filters applied to personal images\"",
  "main": "server/server.js",
  "directories": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocgears/omnifilter.git"
  },
  "author": "Stephen Salzer, Aaron Filson, Gene Troy, Erika Hokanson, Rob Merrill",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ocgears/omnifilter/issues"
  },
  "homepage": "https://github.com/ocgears/omnifilter#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "node-addon-api": "^8.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "eslint": "^8.57.1",
    "mocha": "^12.0.3"
  },
  "scripts": {
    "install": "node scripts/install-native.js",
    "build": "node scripts/client.js build",
    "build:prod": "node scripts/client.js build --production",
    "heroku-postbuild": "OMNIFILTER_API=/ node scripts/client.js build --production",
    "mongo": "mkdir -p db && mongod --dbpath=./db",
    "test": "mkdir -p db && (mongod --dbpath=./db > db/mongod.log 2>&1 &) && mocha --exit --timeout 10000 --file server/test/setup.js server/test",
    "test:client": "node scripts/client.js test",
    "test:e2e": "mkdir -p db && (mongod --dbpath=./db > db/mongod.log 2>&1 &) && playwright test",
    "lint": "eslint .",
    "lint:client": "eslint e2e scripts playwright.config.js clientserver.js lighthouserc.js",
    "start": "mkdir -p db && (mongod --dbpath=./db > db/mongod.log 2>&1 &) && node clientserver & node server/server",
    "fetch-models": "node scripts/fetch-models.js",
    "devices": "node scripts/devices.js",
    "check-device": "node scripts/check-device.js"
  },
  "keywords": [
    "image-filter",
    "parallel-programming",
    "super-fast-filter",
    "omni",
    "filter",
    "filters"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "gypfile": true,
  "optionalDependencies": {
    "onnxruntime-node": "1.19.2"
  }
}
